  "required": [
    "rows",
    "nonconformance_detail",
    "splice_count_plan",
    "splice_count_actual",
    "test_count_plan",
    "test_count_actual",
    "center_test_count_plan",
    "center_test_count_actual",
    "ut_plan",
    "ut_actual"
